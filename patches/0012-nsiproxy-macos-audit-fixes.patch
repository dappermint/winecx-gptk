From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: millia ampora <198710911+dappermint@users.noreply.github.com>
Date: Thu, 13 Aug 2026 01:24:33 +0400
Subject: [PATCH] 0012-nsiproxy-macos-audit-fixes

---
 dlls/nsiproxy.sys/ip.c  | 3 ++-
 dlls/nsiproxy.sys/tcp.c | 3 ++-
 dlls/nsiproxy.sys/udp.c | 1 +
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/dlls/nsiproxy.sys/ip.c b/dlls/nsiproxy.sys/ip.c
index 002d2b48..f8cc54e0 100644
--- a/dlls/nsiproxy.sys/ip.c
+++ b/dlls/nsiproxy.sys/ip.c
@@ -1632,6 +1632,7 @@ static NTSTATUS ipv4_forward_enumerate_all( void *key_data, UINT key_size, void
                 {
                     ERR( "struct sockaddr extends beyond the route message, %p > %p\n",
                          addr_ptr + sa->sa_len, next + rtm->rtm_msglen );
+                    break;
                 }
 
                 if (sa->sa_len) addr_ptr += (sa->sa_len + sizeof(int)-1) & ~(sizeof(int)-1);
@@ -1648,7 +1649,7 @@ static NTSTATUS ipv4_forward_enumerate_all( void *key_data, UINT key_size, void
                      * 5 bytes (1 sa_len, 1 sa_family, 2 sa_port and 1 for the first
                      * byte of sin_addr). */
                     struct sockaddr_in sin = {0};
-                    memcpy( &sin, sa, sa->sa_len );
+                    memcpy( &sin, sa, min( sa->sa_len, sizeof(sin) ) );
                     addr = sin.sin_addr;
                     break;
                 }
diff --git a/dlls/nsiproxy.sys/tcp.c b/dlls/nsiproxy.sys/tcp.c
index 6b1bb9f3..d7a0b638 100644
--- a/dlls/nsiproxy.sys/tcp.c
+++ b/dlls/nsiproxy.sys/tcp.c
@@ -239,7 +239,7 @@ struct ipv6_addr_scope *get_ipv6_addr_scope_table( unsigned int *size )
             struct sockaddr_in6 *sin6;
             struct ipv6_addr_scope *entry;
 
-            if (cur->ifa_addr->sa_family != AF_INET6) continue;
+            if (!cur->ifa_addr || cur->ifa_addr->sa_family != AF_INET6) continue;
 
             if (++num > table_size)
             {
@@ -386,6 +386,7 @@ static NTSTATUS tcp_conns_enumerate_all( UINT filter, struct nsi_tcp_conn_key *k
         }
     }
 
+    free( addr_scopes );
     free( connections );
     return STATUS_SUCCESS;
 }
diff --git a/dlls/nsiproxy.sys/udp.c b/dlls/nsiproxy.sys/udp.c
index 7bb93c9e..0e24143d 100644
--- a/dlls/nsiproxy.sys/udp.c
+++ b/dlls/nsiproxy.sys/udp.c
@@ -282,6 +282,7 @@ static NTSTATUS udp_endpoint_enumerate_all( void *key_data, UINT key_size, void
         }
     }
 
+    free( addr_scopes );
     free( endpoints );
     return STATUS_SUCCESS;
 }
