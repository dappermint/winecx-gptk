+/* Cross-process layer hosting.  A process which needs to render into a window
+ * owned by another process publishes its layer to the window server with a
+ * CAContext, and the owning process displays it with a CALayerHost.  This is
+ * how Chromium's GPU process draws into its browser process's windows, and it
+ * is the only route macOS offers: an NSView can only ever be reached from the
+ * process that created it.
+ *
+ * All three of these are undocumented, so everything is resolved at runtime
+ * and callers fall back to leaving the surface unparented when they are gone.
+ */
+typedef int WineCGSConnectionID;
+extern WineCGSConnectionID CGSMainConnectionID(void) __attribute__((weak_import));
+
+@interface CAContext : NSObject
+    + (id) contextWithCGSConnection:(WineCGSConnectionID)connection options:(NSDictionary*)options;
+    + (id) remoteContextWithOptions:(NSDictionary*)options;
+    @property(readonly) uint32_t contextId;
+    @property(retain) CALayer* layer;
+@end
+
+@interface CALayerHost : CALayer
+    @property uint32_t contextId;
+@end
+
