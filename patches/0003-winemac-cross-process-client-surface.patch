+/***********************************************************************
+ *              macdrv_layer_hosting_available
+ *
+ * Whether this system still has the undocumented pieces needed to show
+ * one process's layer inside another process's window.
+ */
+int macdrv_layer_hosting_available(void)
+{
+    static int available = -1;
+
+    if (available < 0)
+        available = (NSClassFromString(@"CAContext") != nil &&
+                     NSClassFromString(@"CALayerHost") != nil);
+
+    return available;
+}
+
+/***********************************************************************
+ *              macdrv_export_metal_view
+ *
+ * Publish a metal view's layer to the window server so that another
+ * process can display it, and return the context ID identifying it.
+ */
+macdrv_layer_export macdrv_export_metal_view(macdrv_metal_view v, unsigned int *context_id)
+{
+@autoreleasepool
+{
+    WineMetalView* view = (WineMetalView*)v;
+    __block CAContext* context = nil;
+
+    if (!macdrv_layer_hosting_available()) return NULL;
+
+    OnMainThread(^{
+        Class class = NSClassFromString(@"CAContext");
+        CAContext* ctx = nil;
+
+        if (CGSMainConnectionID != NULL &&
+            [class respondsToSelector:@selector(contextWithCGSConnection:options:)])
+            ctx = [class contextWithCGSConnection:CGSMainConnectionID() options:@{}];
+        if (!ctx && [class respondsToSelector:@selector(remoteContextWithOptions:)])
+            ctx = [class remoteContextWithOptions:@{}];
+        if (!ctx) return;
+
+        ctx.layer = view.layer;
+        context = [ctx retain];
+    });
+
+    if (!context) return NULL;
+    *context_id = context.contextId;
+    return (macdrv_layer_export)context;
+}
+}
+
+/***********************************************************************
+ *              macdrv_dispose_layer_export
+ */
+void macdrv_dispose_layer_export(macdrv_layer_export e)
+{
+@autoreleasepool
+{
+    CAContext* context = (CAContext*)e;
+
+    OnMainThread(^{
+        context.layer = nil;
+        [context release];
+    });
+}
+}
+
+/***********************************************************************
+ *              macdrv_create_layer_host
+ *
+ * Display a layer exported by another process in the client area of one
+ * of our windows.  The host view tracks the parent's size, so a resize
+ * of the window is enough to resize the hosted content.
+ */
+macdrv_layer_host macdrv_create_layer_host(macdrv_view parent, unsigned int context_id)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)parent;
+    __block WineLayerHostView* host = nil;
+
+    if (!macdrv_layer_hosting_available()) return NULL;
+
+    OnMainThread(^{
+        host = [[WineLayerHostView alloc] initWithFrame:[view bounds] contextId:context_id];
+        [host setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+        [view setAutoresizesSubviews:YES];
+        [view addSubview:host positioned:NSWindowBelow relativeTo:nil];
+    });
+
+    return (macdrv_layer_host)host;
+}
+}
+
+/***********************************************************************
+ *              macdrv_dispose_layer_host
+ */
+void macdrv_dispose_layer_host(macdrv_layer_host h)
+{
+@autoreleasepool
+{
+    WineLayerHostView* view = (WineLayerHostView*)h;
+
+    OnMainThread(^{
+        [view removeFromSuperview];
+        [view release];
+    });
+}
+}
