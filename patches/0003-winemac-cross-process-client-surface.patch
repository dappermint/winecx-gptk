+/**********************************************************************
+ *              set_hosted_client_layer
+ *
+ * Show a layer belonging to another process in our client area, or stop
+ * showing one when context_id is 0.  Sent by macdrv_vulkan_surface_create()
+ * in the process which is rendering, since it can't reach our Cocoa views.
+ */
+static void set_hosted_client_layer(HWND hwnd, unsigned int context_id)
+{
+    struct macdrv_win_data *data;
+
+    if (!(data = get_win_data(hwnd))) return;
+
+    if (data->layer_host && data->layer_host_id != context_id)
+    {
+        macdrv_dispose_layer_host(data->layer_host);
+        data->layer_host = NULL;
+        data->layer_host_id = 0;
+    }
+
+    if (!data->layer_host && context_id)
+    {
+        if (!data->client_cocoa_view) create_client_cocoa_view(data);
+        if ((data->layer_host = macdrv_create_layer_host(data->client_cocoa_view, context_id)))
+            data->layer_host_id = context_id;
+        else
+            WARN("failed to host layer %u for hwnd %p\n", context_id, hwnd);
+    }
+
+    release_win_data(data);
+}
