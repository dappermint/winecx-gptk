@@ -420,6 +420,20 @@ - (void) removeCALayerHostView:(CAContextID)contextId;
 @end
 
 
+@interface WineD3DMetalRemoteView : WineContentView
+{
+    void* _hwnd;
+    CAContext* _remoteContext;
+    CAContextID _contextId;
+}
+
+- (instancetype) initWithHwnd:(void*)hwnd frame:(NSRect)frame;
+- (BOOL) publishRemoteLayer;
+- (void) unpublishRemoteLayer;
+
+@end
+
+
 @interface WineWindow ()
 
 @property (readwrite, nonatomic) BOOL disabled;
@@ -1064,6 +1078,55 @@ - (BOOL) isOpaque
 @end
 
 
+@implementation WineD3DMetalRemoteView
+
+- (instancetype) initWithHwnd:(void*)hwnd frame:(NSRect)frame
+{
+    self = [super initWithFrame:frame];
+    if (self) _hwnd = hwnd;
+    return self;
+}
+
+- (BOOL) publishRemoteLayer
+{
+    if (_remoteContext) return YES;
+
+    _remoteContext = [[CAContext contextWithCGSConnection:CGSMainConnectionID()
+                                               options:[NSDictionary dictionary]] retain];
+    [_remoteContext setLayer:self.layer];
+    _contextId = [_remoteContext contextId];
+    if (!_contextId)
+    {
+        [_remoteContext setLayer:nil];
+        [_remoteContext release];
+        _remoteContext = nil;
+        return NO;
+    }
+
+    macdrv_create_remote_layer(_hwnd, _contextId);
+    return YES;
+}
+
+- (void) unpublishRemoteLayer
+{
+    if (!_remoteContext) return;
+
+    macdrv_release_remote_layer(_hwnd, _contextId);
+    [_remoteContext setLayer:nil];
+    [_remoteContext release];
+    _remoteContext = nil;
+    _contextId = 0;
+}
+
+- (void) dealloc
+{
+    [self unpublishRemoteLayer];
+    [super dealloc];
+}
+
+@end
+
