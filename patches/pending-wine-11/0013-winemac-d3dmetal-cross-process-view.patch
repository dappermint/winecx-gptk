     });
 }
 
+macdrv_view macdrv_create_d3dmetal_remote_view(void* hwnd, CGRect rect)
+{
+@autoreleasepool
+{
+    __block WineD3DMetalRemoteView* view;
+
+    OnMainThread(^{
+        view = [[WineD3DMetalRemoteView alloc] initWithHwnd:hwnd
+                                                      frame:NSRectFromCGRect(cgrect_mac_from_win(rect))];
+    });
+
+    return (macdrv_view)view;
+}
+}
+
+int macdrv_publish_d3dmetal_remote_view(macdrv_view v)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    __block BOOL remote = NO;
+
+    OnMainThread(^{
+        if ([view isKindOfClass:[WineD3DMetalRemoteView class]])
+            remote = [(WineD3DMetalRemoteView*)view publishRemoteLayer];
+    });
+
+    return remote;
+}
+}
+
+int macdrv_release_d3dmetal_remote_view(macdrv_metal_view v)
+{
+@autoreleasepool
+{
+    WineMetalView* metal_view = (WineMetalView*)v;
+    __block BOOL remote = NO;
+
+    OnMainThread(^{
+        WineContentView* view = (WineContentView*)[metal_view superview];
+
+        if ([view isKindOfClass:[WineD3DMetalRemoteView class]])
+        {
+            remote = YES;
+            [(WineD3DMetalRemoteView*)view unpublishRemoteLayer];
+            [metal_view removeFromSuperview];
+            [metal_view release];
+            [view release];
+        }
+    });
+
+    return remote;
+}
+}
+
 @protocol WineMetalSwapChain <NSObject>
 
 - (CAMetalLayer*) layer;
