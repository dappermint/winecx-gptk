Cocoa titles the application menu from the main bundle's CFBundleName, and
a wine process has no bundle, so the menu reads a bare "Quit" and "Hide"
instead of "Quit Steam" and "Hide Steam".  Derive a name from the running
exe and use it when the bundle has none.

Note this does NOT rename the Dock tile.  The Dock uses
NSRunningApplication.localizedName, which is resolved from the bundle at
launch; measured on macOS 27, mutating CFBundleName or calling
setProcessName: afterwards leaves localizedName unchanged, while the same
binary placed in a minimal .app bundle reports the bundle name from the
start.  A true Dock name needs a real .app wrapper around the launch,
which belongs to whatever creates the shortcut, not to the driver.

diff --git a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
index 034cbee..caf3f37 100644
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -363,6 +363,17 @@ - (void) transformProcessToForeground:(BOOL)activateIfTransformed
             // Application menu
             submenu = [[[NSMenu alloc] initWithTitle:WineLocalizedString(STRING_MENU_WINE)] autorelease];
             bundleName = [[NSBundle mainBundle] objectForInfoDictionaryKey:(NSString*)kCFBundleNameKey];
+            if (![bundleName length] && *app_name)
+            {
+                bundleName = [NSString stringWithUTF8String:app_name];
+                /* so anything else asking the bundle sees the same name */
+                @try
+                {
+                    [(NSMutableDictionary*)[[NSBundle mainBundle] infoDictionary]
+                        setObject:bundleName forKey:(NSString*)kCFBundleNameKey];
+                }
+                @catch (NSException *e) { }
+            }
 
             if ([bundleName length])
                 title = [NSString stringWithFormat:WineLocalizedString(STRING_MENU_ITEM_HIDE_APPNAME), bundleName];
