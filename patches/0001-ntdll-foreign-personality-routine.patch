From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: millia ampora <198710911+dappermint@users.noreply.github.com>
Date: Thu, 13 Aug 2026 01:24:32 +0400
Subject: [PATCH] 0001-ntdll-foreign-personality-routine

---
 dlls/ntdll/signal_x86_64.c | 2 +-
 dlls/ntdll/unwind.c        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/signal_x86_64.c b/dlls/ntdll/signal_x86_64.c
index a5bbbaea..cb199188 100644
--- a/dlls/ntdll/signal_x86_64.c
+++ b/dlls/ntdll/signal_x86_64.c
@@ -100,7 +100,7 @@ WINE_DECLARE_DEBUG_CHANNEL(relay);
  */
 static NTSTATUS virtual_unwind( ULONG type, DISPATCHER_CONTEXT *dispatch, CONTEXT *context )
 {
-    LDR_DATA_TABLE_ENTRY *module;
+    LDR_DATA_TABLE_ENTRY *module = NULL;
     NTSTATUS status;
 
     dispatch->ImageBase = 0;
diff --git a/dlls/ntdll/unwind.c b/dlls/ntdll/unwind.c
index 6e2b8641..237a2266 100644
--- a/dlls/ntdll/unwind.c
+++ b/dlls/ntdll/unwind.c
@@ -2072,7 +2072,7 @@ NTSTATUS WINAPI RtlVirtualUnwind2( ULONG type, ULONG_PTR base, ULONG_PTR pc,
     {
         context->Rip = *(ULONG64 *)context->Rsp;
         context->Rsp += sizeof(ULONG64);
-        *data = NULL;
+        if (data) *data = NULL;
         *handler_ret = NULL;
         return STATUS_SUCCESS;
     }
