win32u: answer the adapter identity and segment size queries

Five more KMTQAITYPEs, all of which this stack can answer honestly. None are
upstream or Proton; the payload layouts come from the DDK reference for
d3dkmthk.h, which is also where the struct definitions are from.

  ADAPTERTYPE            render and display, nothing else. Not SoftwareDevice:
                         there is a real GPU behind this. Not HybridDiscrete or
                         HybridIntegrated, which mean one half of a switchable
                         pair, not "integrated".
  PHYSICALADAPTERCOUNT   1. Wine has no linked adapters, which
                         NtGdiDdDDIQueryVideoMemoryInfo already says in as many
                         words when it rejects PhysicalAdapterIndex > 0.
  ADAPTERADDRESS         zeroes. The field is a PCI bus/device/function triple
                         and Apple silicon has no PCI bus to name; Vulkan will
                         not report one either without VK_EXT_pci_bus_info,
                         which MoltenVK does not implement.
  ADAPTERGUID            the Vulkan deviceUUID, the same 16 bytes
                         get_vulkan_physical_device already matches adapters on
                         and d3dkmt_get_vulkan_gpus already copies into the GPU
                         list, so an app that pairs this against either sees one
                         consistent identity.
  GETSEGMENTSIZE         Vulkan heap sizes, device-local into
                         DedicatedVideoMemorySize and the rest into
                         SharedSystemMemorySize, the same split
                         NtGdiDdDDIQueryVideoMemoryInfo makes three functions
                         down. DedicatedSystemMemorySize stays 0: there is no
                         carve-out of system memory here, it is one unified pool.

The last two are gated on adapter->vk_device and fail with
STATUS_INVALID_PARAMETER without it, which is not the vestigial guard that got
removed from the 2.7 caps case in the previous patch. These two genuinely read
the physical device, and NtGdiDdDDIOpenAdapterFromLuid hands out adapters with a
null vk_device whenever the LUID matched nothing, so the guard is load-bearing.

Deliberately still STATUS_NOT_IMPLEMENTED: the WDDM 1.2 / 1.3 / 2.0 / 2.9 / 3.0
/ 3.1 caps blocks and QUERYREGISTRY. Every one of the caps blocks would answer
all-zero the way 2.7 does, so the only thing they need is a struct of exactly
the right size, and getting that wrong fails in both directions: too small and
the caller reads an uninitialised tail, too large and the size check rejects a
valid call. D3DKMT_WDDM_1_2_CAPS alone pulls D3DKMDT_PREEMPTION_CAPS and two
granularity enums out of d3dkmdt.h, a header this tree does not carry at all.
Not worth porting until something asks for them; tests/qaiprobe.c reports which
types actually get asked.

diff --git i/dlls/win32u/d3dkmt.c w/dlls/win32u/d3dkmt.c
index a7f7a647..f8e1c4ba 100644
--- i/dlls/win32u/d3dkmt.c
+++ w/dlls/win32u/d3dkmt.c
@@ -370,6 +370,91 @@ NTSTATUS WINAPI NtGdiDdDDIQueryAdapterInfo( D3DKMT_QUERYADAPTERINFO *desc )
         memset( value, 0, sizeof(*value) );
         return STATUS_SUCCESS;
     }
+    case KMTQAITYPE_ADAPTERTYPE:
+    {
+        D3DKMT_ADAPTERTYPE *value = desc->pPrivateDriverData;
+
+        if (desc->PrivateDriverDataSize < sizeof(*value))
+            return STATUS_INVALID_PARAMETER;
+
+        memset( value, 0, sizeof(*value) );
+        value->RenderSupported = 1;
+        value->DisplaySupported = 1;
+        return STATUS_SUCCESS;
+    }
+    case KMTQAITYPE_PHYSICALADAPTERCOUNT:
+    {
+        D3DKMT_PHYSICAL_ADAPTER_COUNT *value = desc->pPrivateDriverData;
+
+        if (desc->PrivateDriverDataSize < sizeof(*value))
+            return STATUS_INVALID_PARAMETER;
+
+        value->Count = 1;
+        return STATUS_SUCCESS;
+    }
+    case KMTQAITYPE_ADAPTERADDRESS:
+    {
+        D3DKMT_ADAPTERADDRESS *value = desc->pPrivateDriverData;
+
+        if (desc->PrivateDriverDataSize < sizeof(*value))
+            return STATUS_INVALID_PARAMETER;
+
+        /* There is no PCI bus to report a location on. */
+        memset( value, 0, sizeof(*value) );
+        return STATUS_SUCCESS;
+    }
+    case KMTQAITYPE_ADAPTERGUID:
+    {
+        VkPhysicalDeviceIDProperties id = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+        VkPhysicalDeviceProperties2 properties2 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &id};
+        NTSTATUS status = STATUS_INVALID_PARAMETER;
+        GUID *value = desc->pPrivateDriverData;
+        struct d3dkmt_adapter *adapter;
+
+        if (desc->PrivateDriverDataSize < sizeof(*value))
+            return STATUS_INVALID_PARAMETER;
+
+        pthread_mutex_lock( &d3dkmt_lock );
+        if ((adapter = find_adapter_from_handle( desc->hAdapter )) && adapter->vk_device)
+        {
+            pvkGetPhysicalDeviceProperties2KHR( adapter->vk_device, &properties2 );
+            memcpy( value, id.deviceUUID, sizeof(*value) );
+            status = STATUS_SUCCESS;
+        }
+        pthread_mutex_unlock( &d3dkmt_lock );
+
+        return status;
+    }
+    case KMTQAITYPE_GETSEGMENTSIZE:
+    {
+        VkPhysicalDeviceMemoryProperties2 properties2 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2};
+        D3DKMT_SEGMENTSIZEINFO *value = desc->pPrivateDriverData;
+        NTSTATUS status = STATUS_INVALID_PARAMETER;
+        struct d3dkmt_adapter *adapter;
+        unsigned int i;
+
+        if (desc->PrivateDriverDataSize < sizeof(*value))
+            return STATUS_INVALID_PARAMETER;
+
+        memset( value, 0, sizeof(*value) );
+
+        pthread_mutex_lock( &d3dkmt_lock );
+        if ((adapter = find_adapter_from_handle( desc->hAdapter )) && adapter->vk_device)
+        {
+            pvkGetPhysicalDeviceMemoryProperties2KHR( adapter->vk_device, &properties2 );
+            for (i = 0; i < properties2.memoryProperties.memoryHeapCount; ++i)
+            {
+                if (properties2.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)
+                    value->DedicatedVideoMemorySize += properties2.memoryProperties.memoryHeaps[i].size;
+                else
+                    value->SharedSystemMemorySize += properties2.memoryProperties.memoryHeaps[i].size;
+            }
+            status = STATUS_SUCCESS;
+        }
+        pthread_mutex_unlock( &d3dkmt_lock );
+
+        return status;
+    }
     default:
     {
         FIXME( "type %d not handled.\n", desc->Type );
